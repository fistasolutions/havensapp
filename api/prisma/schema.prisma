// Prisma Schema for Havens App MVP
// PostgreSQL 14+ with pgcrypto extension for encryption

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Role Enum
enum UserRole {
  Individual
  Provider
  Partner
  FamilyFriends
  Kid
}

// Provider Verification Status Enum
enum ProviderVerificationStatus {
  Pending
  Verified
  Rejected
}

// Conversation Flow Enum
enum ConversationFlow {
  AnxietyRelief
  StressManagement
  DepressionSupport
  General
  Custom
}

// User Model - Core entity for authentication and user management
model User {
  id                        String                    @id @default(uuid()) @db.Uuid
  email                     String                    @unique @db.VarChar(255)
  passwordHash              String                    @db.VarChar(255)
  role                      UserRole                  @default(Individual)
  firstName                 String?                   @db.VarChar(100)
  lastName                  String?                   @db.VarChar(100)
  age                       Int?
  providerLicenseNumber     String?                   @db.VarChar(100) // Encrypted field
  providerVerificationStatus ProviderVerificationStatus?
  parentUserId              String?                   @db.Uuid
  analyticsConsent          Boolean                   @default(false)
  dataRetentionPreference   Int                       @default(2555) // 7 years in days
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  deletedAt                 DateTime?
  lastLoginAt               DateTime?

  // Self-referential relationship for parent-child (Kids mode)
  parent                    User?                     @relation("ParentChild", fields: [parentUserId], references: [id])
  children                  User[]                    @relation("ParentChild")

  // Relationships
  chatbotConversations ChatbotConversation[]
  // moodEntries              MoodEntry[]
  // journalEntries           JournalEntry[]
  // exerciseCompletions      ExerciseCompletion[]
  // userProgress             UserProgress?

  @@index([email])
  @@index([role])
  @@index([parentUserId])
  @@index([deletedAt])
  @@map("users")
}

// ChatbotConversation Model
model ChatbotConversation {
  id                        String            @id @default(uuid()) @db.Uuid
  userId                    String            @db.Uuid
  conversationFlow           ConversationFlow  @default(General)
  messages                  Json              // Array of message objects (encrypted)
  personalizationContext    Json?             // User context for personalization
  crisisDetected            Boolean           @default(false)
  crisisResourcesProvided   Boolean           @default(false)
  isActive                  Boolean           @default(true)
  syncedAt                  DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  // Relationships
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([crisisDetected])
  @@index([userId, isActive])
  @@map("chatbot_conversations")
}

